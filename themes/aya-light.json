  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#7c3aed",
    "property": "#a16207",
    "interface": "#a21caf",
    "type": "#a21caf",
    "class": "#7c3aed"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": {
        "foreground": "#c4b5d0"
      }
    },
    {
      "scope": [
        "delimiter.bracket",
        "delimiter",
        "invalid.illegal.character-not-allowed-here.html",
        "keyword.operator.rest",
        "keyword.operator.spread",
        "keyword.operator.type.annotation",
        "keyword.operator.relational",
        "keyword.operator.assignment",
        "keyword.operator.type",
        "meta.brace",
        "meta.tag.block.any.html",
        "meta.tag.inline.any.html",
        "meta.tag.structure.input.void.html",
        "meta.type.annotation",
        "meta.embedded.block.github-actions-expression",
        "storage.type.function.arrow",
        "meta.objectliteral.ts",
        "punctuation"
      ],
      "settings": {
        "foreground": "#777777"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.language",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#a65e2b"
      }
    },
    {
      "scope": ["entity", "entity.name"],
      "settings": {
        "foreground": "#d946ef"
      }
    },
    {
      "scope": "variable.parameter.function",
      "settings": {
        "foreground": "#393a34"
      }
    },
    {
      "scope": ["entity.name.tag", "tag.html"],
      "settings": {
        "foreground": "#6d28d9"
      }
    },
    {
      "scope": "entity.name.function",
      "settings": {
        "foreground": "#a78bfa"
      }
    },
    {
      "scope": ["keyword", "storage.type.class.jsdoc"],
      "settings": {
        "foreground": "#6d28d9"
      }
    },
    {
      "scope": [
        "storage",
        "storage.type",
        "support.type.builtin",
        "constant.language.undefined",
        "constant.language.null"
      ],
      "settings": {
        "foreground": "#dc2626"
      }
    },
    {
      "scope": [
        "text.html.derivative",
        "storage.modifier.package",
        "storage.modifier.import",
        "storage.type.java"
      ],
      "settings": {
        "foreground": "#393a34"
      }
    },
    {
      "scope": [
        "string",
        "string punctuation.section.embedded source",
        "attribute.value"
      ],
      "settings": {
        "foreground": "#c2410c"
      }
    },
    {
      "scope": [
        "punctuation.definition.string",
        "punctuation.support.type.property-name"
      ],
      "settings": {
        "foreground": "#c2410c99"
      }
    },
    {
      "scope": "support",
      "settings": {
        "foreground": "#a16207"
      }
    },
    {
      "scope": [
        "property",
        "meta.property-name",
        "meta.object-literal.key",
        "entity.name.tag.yaml",
        "attribute.name"
      ],
      "settings": {
        "foreground": "#a16207"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "invalid.deprecated.entity.other.attribute-name.html"
      ],
      "settings": {
        "foreground": "#92400e"
      }
    },
    {
      "scope": ["variable", "identifier"],
      "settings": {
        "foreground": "#92400e"
      }
    },
    {
      "scope": ["support.type.primitive", "entity.name.type"],
      "settings": {
        "foreground": "#a21caf"
      }
    },
    {
      "scope": "namespace",
      "settings": {
        "foreground": "#7c3aed"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment.compound",
        "meta.var.expr.ts"
      ],
      "settings": {
        "foreground": "#dc2626"
      }
    },
    {
      "scope": "invalid.broken",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#dc2626"
      }
    },
    {
      "scope": "invalid.deprecated",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#dc2626"
      }
    },
    {
      "scope": "invalid.illegal",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#dc2626"
      }
    },
    {
      "scope": "invalid.unimplemented",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#dc2626"
      }
    },
    {
      "scope": "carriage-return",
      "settings": {
        "fontStyle": "italic underline",
        "background": "#d73a49",
        "foreground": "#fafbfc",
        "content": "^M"
      }
    },
    {
      "scope": "message.error",
      "settings": {
        "foreground": "#dc2626"
      }
    },
    {
      "scope": "string variable",
      "settings": {
        "foreground": "#c2410c"
      }
    },
    {
      "scope": ["source.regexp", "string.regexp"],
      "settings": {
        "foreground": "#ab5e3f"
      }
    },
    {
      "scope": [
        "string.regexp.character-class",
        "string.regexp constant.character.escape",
        "string.regexp source.ruby.embedded",
        "string.regexp string.regexp.arbitrary-repitition"
      ],
      "settings": {
        "foreground": "#c2410c"
      }
    },
    {
      "scope": "string.regexp constant.character.escape",
      "settings": {
        "foreground": "#bda437"
      }
    },
    {
      "scope": ["support.constant"],
      "settings": {
        "foreground": "#a65e2b"
      }
    },
    {
      "scope": [
        "keyword.operator.quantifier.regexp",
        "constant.numeric",
        "number"
      ],
      "settings": {
        "foreground": "#a21caf"
      }
    },
    {
      "scope": ["keyword.other.unit"],
      "settings": {
        "foreground": "#dc2626"
      }
    },
    {
      "scope": ["constant.language.boolean", "constant.language"],
      "settings": {
        "foreground": "#6d28d9"
      }
    },
    {
      "scope": "meta.module-reference",
      "settings": {
        "foreground": "#a78bfa"
      }
    },
    {
      "scope": "punctuation.definition.list.begin.markdown",
      "settings": {
        "foreground": "#a65e2b"
      }
    },
    {
      "scope": ["markup.heading", "markup.heading entity.name"],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#a78bfa"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#a21caf"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#393a34"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#393a34"
      }
    },
    {
      "scope": "markup.raw",
      "settings": {
        "foreground": "#a78bfa"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "background": "#ffeef0",
        "foreground": "#dc2626"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "background": "#fdf2f8",
        "foreground": "#fb7185"
      }
    },
    {
      "scope": ["markup.changed", "punctuation.definition.changed"],
      "settings": {
        "background": "#ffebda",
        "foreground": "#e36209"
      }
    },
    {
      "scope": ["markup.ignored", "markup.untracked"],
      "settings": {
        "foreground": "#f6f8fa",
        "background": "#7c3aed"
      }
    },
    {
      "scope": "meta.diff.range",
      "settings": {
        "foreground": "#6f42c1",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "meta.diff.header",
      "settings": {
        "foreground": "#7c3aed"
      }
    },
    {
      "scope": "meta.separator",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#7c3aed"
      }
    },
    {
      "scope": "meta.output",
      "settings": {
        "foreground": "#7c3aed"
      }
    },
    {
      "scope": [
        "brackethighlighter.tag",
        "brackethighlighter.curly",
        "brackethighlighter.round",
        "brackethighlighter.square",
        "brackethighlighter.angle",
        "brackethighlighter.quote"
      ],
      "settings": {
        "foreground": "#586069"
      }
    },
    {
      "scope": "brackethighlighter.unmatched",
      "settings": {
        "foreground": "#dc2626"
      }
    },
    {
      "scope": [
        "constant.other.reference.link",
        "string.other.link",
        "punctuation.definition.string.begin.markdown",
        "punctuation.definition.string.end.markdown"
      ],
      "settings": {
        "foreground": "#c2410c"
      }
    },
    {
      "scope": [
        "markup.underline.link.markdown",
        "markup.underline.link.image.markdown"
      ],
      "settings": {
        "foreground": "#393a3490",
        "fontStyle": "underline"
      }
    },
    {
      "scope": ["type.identifier", "constant.other.character-class.regexp"],
      "settings": {
        "foreground": "#7c3aed"
      }
    },
    {
      "scope": ["entity.other.attribute-name.html.vue"],
      "settings": {
        "foreground": "#d946ef"
      }
    },
    {
      "scope": ["invalid.illegal.unrecognized-tag.html"],
      "settings": {
        "fontStyle": "normal"
      }
    }
  ],
  "rules": [
    {
      "token": "comment",
      "foreground": "c4b5d0"
    },
    {
      "token": "punctuation.definition.comment",
      "foreground": "c4b5d0"
    },
    {
      "token": "string.comment",
      "foreground": "c4b5d0"
    },
    {
      "token": "delimiter.bracket",
      "foreground": "777777"
    },
    {
      "token": "delimiter",
      "foreground": "777777"
    },
    {
      "token": "invalid.illegal.character-not-allowed-here.html",
      "foreground": "777777"
    },
    {
      "token": "keyword.operator.rest",
      "foreground": "777777"
    },
    {
      "token": "keyword.operator.spread",
      "foreground": "777777"
    },
    {
      "token": "keyword.operator.type.annotation",
      "foreground": "777777"
    },
    {
      "token": "keyword.operator.relational",
      "foreground": "777777"
    },
    {
      "token": "keyword.operator.assignment",
      "foreground": "777777"
    },
    {
      "token": "keyword.operator.type",
      "foreground": "777777"
    },
    {
      "token": "meta.brace",
      "foreground": "777777"
    },
    {
      "token": "meta.tag.block.any.html",
      "foreground": "777777"
    },
    {
      "token": "meta.tag.inline.any.html",
      "foreground": "777777"
    },
    {
      "token": "meta.tag.structure.input.void.html",
      "foreground": "777777"
    },
    {
      "token": "meta.type.annotation",
      "foreground": "777777"
    },
    {
      "token": "meta.embedded.block.github-actions-expression",
      "foreground": "777777"
    },
    {
      "token": "storage.type.function.arrow",
      "foreground": "777777"
    },
    {
      "token": "meta.objectliteral.ts",
      "foreground": "777777"
    },
    {
      "token": "punctuation",
      "foreground": "777777"
    },
    {
      "token": "constant",
      "foreground": "a65e2b"
    },
    {
      "token": "entity.name.constant",
      "foreground": "a65e2b"
    },
    {
      "token": "variable.language",
      "foreground": "a65e2b"
    },
    {
      "token": "meta.definition.variable",
      "foreground": "a65e2b"
    },
    {
      "token": "entity",
      "foreground": "d946ef"
    },
    {
      "token": "entity.name",
      "foreground": "d946ef"
    },
    {
      "token": "variable.parameter.function",
      "foreground": "393a34"
    },
    {
      "token": "entity.name.tag",
      "foreground": "6d28d9"
    },
    {
      "token": "tag.html",
      "foreground": "6d28d9"
    },
    {
      "token": "entity.name.function",
      "foreground": "2563a0"
    },
    {
      "token": "keyword",
      "foreground": "6d28d9"
    },
    {
      "token": "storage.type.class.jsdoc",
      "foreground": "6d28d9"
    },
    {
      "token": "storage",
      "foreground": "dc2626"
    },
    {
      "token": "storage.type",
      "foreground": "dc2626"
    },
    {
      "token": "support.type.builtin",
      "foreground": "dc2626"
    },
    {
      "token": "constant.language.undefined",
      "foreground": "dc2626"
    },
    {
      "token": "constant.language.null",
      "foreground": "dc2626"
    },
    {
      "token": "text.html.derivative",
      "foreground": "393a34"
    },
    {
      "token": "storage.modifier.package",
      "foreground": "393a34"
    },
    {
      "token": "storage.modifier.import",
      "foreground": "393a34"
    },
    {
      "token": "storage.type.java",
      "foreground": "393a34"
    },
    {
      "token": "string",
      "foreground": "c2410c"
    },
    {
      "token": "string punctuation.section.embedded source",
      "foreground": "c2410c"
    },
    {
      "token": "attribute.value",
      "foreground": "c2410c"
    },
